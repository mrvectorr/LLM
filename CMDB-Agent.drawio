        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Styling\n    classDef zoneIn fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#0f172a\n    classDef zoneCore fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#0f172a\n    classDef zoneCloud fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#0f172a\n    classDef boxWhite fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px,color:#1e293b\n    classDef boxSec fill:#f8fafc,stroke:#334155,stroke-width:2px,color:#0f172a\n    classDef boxBlock fill:#fef2f2,stroke:#dc2626,stroke-width:2px,stroke-dasharray: 5 5,color:#991b1b\n    classDef boxCost fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b\n\n    %% =========================================================\n    %% 1. DATENQUELLEN &amp; FRESHSERVICE\n    %% =========================================================\n    subgraph IN[\&quot;1. DATENQUELLEN &amp; FRESHSERVICE\&quot;]\n        direction TB\n        FS[\&quot;🎫 Freshservice Tickets &amp; KB&lt;br/&gt;• Neue Tickets (Trigger)&lt;br/&gt;• Gelöste Tickets &amp; Lösungsartikel&lt;br/&gt;• CMDB (Computernummern-Abgleich)\&quot;]:::boxWhite\n\n        WIKI[\&quot;📖 Internes IT-Wiki&lt;br/&gt;• Standardisierungen &amp; Checklisten&lt;br/&gt;• Pflichtfeld-Regeln (z. B. PC-Nr.)\&quot;]:::boxWhite\n\n        GUARD[\&quot;🚫 START-SCHUTZ (PHASE 1):&lt;br/&gt;• Agent 2 schreibt NUR Private Notes&lt;br/&gt;• Keine Public Replies an User&lt;br/&gt;• Rückfragen an User erst nach Freigabe\&quot;]:::boxBlock\n\n        TECH[\&quot;👨‍💻 IT-Mitarbeiter&lt;br/&gt;• Sieht sortiertes Ticket + interne Notiz&lt;br/&gt;• Sendet fertige Antwort mit 1 Klick\&quot;]:::boxSec\n\n        FS --- GUARD\n        FS --&gt; TECH\n    end\n\n    %% =========================================================\n    %% 2. N8N WORKFLOW-ENGINE (2 AGENTEN)\n    %% =========================================================\n    subgraph CORE[\&quot;2. FIRMENNETZ: n8n ENGINE (VM / Client | 0 € Lizenz)\&quot;]\n        direction TB\n        RAG[(\&quot;🗄️ Wissens-Index (RAG | 0 €)&lt;br/&gt;• Sync aus Freshservice KB, alten&lt;br/&gt;  Tickets &amp; Wiki (Dauer: ~20 Min.)\&quot;)]:::boxWhite\n\n        AG1[\&quot;🥇 AGENT 1: Prio- &amp; Sortier-Agent&lt;br/&gt;1. Prüft: Kann KI das lösen?&lt;br/&gt;2. Pflichtdaten-Check: Bei PC-Thema&lt;br/&gt;   muss Computernummer vorhanden sein!&lt;br/&gt;3. Setzt Prio &amp; routet an Fachgruppe&lt;br/&gt;   (oder markiert fehlende Daten)\&quot;]:::boxWhite\n\n        AG2[\&quot;🥈 AGENT 2: Wissens- &amp; Lösungs-Agent&lt;br/&gt;1. Durchsucht Wiki, KB &amp; alte Tickets&lt;br/&gt;2. Sucht bei unbekanntem Fehlercode&lt;br/&gt;   SELBSTSTÄNDIG im Web (anonymisiert)&lt;br/&gt;3. Schreibt interne Notiz (Zusammenfassung,&lt;br/&gt;   Lösungsweg &amp; Antwortentwurf)\&quot;]:::boxWhite\n\n        WEB[\&quot;🌐 Autonome Web-Suche&lt;br/&gt;• SearXNG (0 €) oder Azure Bing&lt;br/&gt;• Nur neutraler Fehlercode (ohne PII)\&quot;]:::boxWhite\n\n        RAG &lt;--&gt; AG1\n        RAG &lt;--&gt; AG2\n        AG1 --&gt;|\&quot;Daten komplett &amp;&lt;br/&gt;KI-geeignet\&quot;| AG2\n        AG2 &lt;--&gt;|\&quot;Fehlermeldung&lt;br/&gt;suchen\&quot;| WEB\n    end\n\n    %% =========================================================\n    %% 3. MICROSOFT AZURE AI (EU DATA ZONE)\n    %% =========================================================\n    subgraph CLOUD[\&quot;3. MICROSOFT AZURE CLOUD (EU Data Zone | DSGVO-AVV)\&quot;]\n        direction TB\n        AZ_SEC[\&quot;🇪🇺 Region: Sweden Central / DE&lt;br/&gt;• Kein Training mit Firmendaten&lt;br/&gt;• Hartes Budget-Limit: 15 €/Monat\&quot;]:::boxSec\n\n        LLM1[\&quot;⚡ Modell für Agent 1 (Sortieren):&lt;br/&gt;GPT-4o-mini / GPT-4.1-mini&lt;br/&gt;• Extrem schnell &amp; günstig\&quot;]:::boxWhite\n\n        LLM2[\&quot;🧠 Modell für Agent 2 (Wissen/Web):&lt;br/&gt;GPT-4o / GPT-4.1&lt;br/&gt;• Hohe Analyse- &amp; Textqualität\&quot;]:::boxWhite\n\n        COST[\&quot;💰 KOSTEN PRO MONAT (1.000 Tickets)&lt;br/&gt;──────────────────────────────&lt;br/&gt;• Agent 1 (Prio &amp; Pflichtfeld-Check):&lt;br/&gt;  ca. 1,00 € – 2,00 € / Monat&lt;br/&gt;• Agent 2 (Wiki, Web-Suche &amp; Notiz):&lt;br/&gt;  ca. 4,00 € – 8,00 € / Monat&lt;br/&gt;• n8n + Wissens-Index + SearXNG:&lt;br/&gt;  0,00 € (Self-Hosted)&lt;br/&gt;──────────────────────────────&lt;br/&gt;GESAMTKOSTEN: ca. 5 € – 10 € / Monat\&quot;]:::boxCost\n\n        AZ_SEC --- LLM1\n        AZ_SEC --- LLM2\n        LLM2 --- COST\n    end\n\n    %% =========================================================\n    %% VERBINDUNGEN\n    %% =========================================================\n    FS &lt;==&gt;|\&quot;REST-API (HTTPS)\&quot;| AG1\n    WIKI --&gt;|\&quot;Nacht-Sync\&quot;| RAG\n    FS --&gt;|\&quot;KB &amp; Historie\&quot;| RAG\n    AG2 --&gt;|\&quot;Private Note\&quot;| FS\n\n    AG1 &lt;==&gt;|\&quot;HTTPS / API\&quot;| LLM1\n    AG2 &lt;==&gt;|\&quot;HTTPS / API\&quot;| LLM2\n\n    class IN zoneIn\n    class CORE zoneCore\n    class CLOUD zoneCloud\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="H-1TOwg96gkfakXF2Tzw-47">
