        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Styling-Klassen\n    classDef zoneIn fill:#fffbeb,stroke:#d97706,stroke-width:2px,color:#0f172a\n    classDef zoneCore fill:#eff6ff,stroke:#2563eb,stroke-width:2px,color:#0f172a\n    classDef zoneCloud fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#0f172a\n    classDef zoneAuto fill:#f5f3ff,stroke:#7c3aed,stroke-width:2px,color:#0f172a\n    classDef boxWhite fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px,color:#1e293b\n    classDef boxSec fill:#f8fafc,stroke:#334155,stroke-width:2px,color:#0f172a\n    classDef boxBlock fill:#fef2f2,stroke:#dc2626,stroke-width:2px,stroke-dasharray: 5 5,color:#991b1b\n    classDef boxCost fill:#ecfdf5,stroke:#059669,stroke-width:2px,color:#064e3b\n    classDef boxFuture fill:#fdf4ff,stroke:#c026d3,stroke-width:1.5px,stroke-dasharray: 4 4,color:#701a75\n\n    %% =========================================================\n    %% 1. EINGANGSKANÄLE (TICKETS, CHAT, HOTLINE)\n    %% =========================================================\n    subgraph IN[\&quot;1. EINGANGSKANÄLE &amp; HUMAN-IN-THE-LOOP\&quot;]\n        direction TB\n        FS[\&quot;🎫 Freshservice Tickets&lt;br/&gt;• API-Key (Least Privilege)&lt;br/&gt;• Liest Tickets &amp; schreibt&lt;br/&gt;  NUR Private Notes\&quot;]:::boxWhite\n        \n        TEAMS[\&quot;💬 MS Teams / Self-Service&lt;br/&gt;• Passwort- &amp; Status-Bot&lt;br/&gt;• Rückfragen an User\&quot;]:::boxWhite\n\n        VOICE_IN[\&quot;📞 IT-Hotline (Ausbaustufe 2)&lt;br/&gt;• Telefonanlage / Teams Voice&lt;br/&gt;• Anrufer spricht Problem ein\&quot;]:::boxFuture\n\n        GUARD_FS[\&quot;🚫 BLOCKIERT:&lt;br/&gt;• Keine Public Replies&lt;br/&gt;• Kein Ticket-Schließen&lt;br/&gt;• Keine unbestätigten Skripte\&quot;]:::boxBlock\n\n        HUMAN[\&quot;👨‍💻 IT-Techniker (Freigabe)&lt;br/&gt;• Prüft Entwurf &amp; PowerShell&lt;br/&gt;• Gibt Aktionen frei &amp; schließt Ticket\&quot;]:::boxSec\n\n        FS --- GUARD_FS\n        FS --&gt; HUMAN\n    end\n\n    %% =========================================================\n    %% 2. N8N MULTI-AGENTEN &amp; WORKFLOW-ENGINE\n    %% =========================================================\n    subgraph CORE[\&quot;2. FIRMENNETZ: n8n ORCHESTRATOR &amp; MULTI-AGENTEN (VM | 0 € Lizenz)\&quot;]\n        direction TB\n        FW[\&quot;🔒 Firewall &amp; Guardrails&lt;br/&gt;• Inbound: Port 5678 gesperrt&lt;br/&gt;• Outbound: Nur Allowlist&lt;br/&gt;  (Freshservice, Azure, MS Graph)\&quot;]:::boxSec\n\n        ROUTER[\&quot;🧭 Supervisor / Router-Workflow&lt;br/&gt;• Erkennt Kanal, Typ &amp; Risiko-Level&lt;br/&gt;• Verteilt Aufgaben an Spezial-Agenten\&quot;]:::boxWhite\n\n        subgraph AGENTS[\&quot;Spezialisierte KI-Agenten\&quot;]\n            direction TB\n            AG1[\&quot;🤖 1. Triage- &amp; Routing-Agent&lt;br/&gt;• Kategorie, Prio, Duplikate\&quot;]:::boxWhite\n            AG2[\&quot;🔍 2. Wissens- &amp; Recherche-Agent&lt;br/&gt;• SOPs + Microsoft Docs\&quot;]:::boxWhite\n            AG3[\&quot;⚙️ 3. PowerShell- &amp; Skript-Agent&lt;br/&gt;• Code-Generierung (AD/Intune)\&quot;]:::boxWhite\n            AG4[\&quot;📚 4. Doku- &amp; KB-Agent&lt;br/&gt;• Erstellt neue IT-Anleitungen\&quot;]:::boxWhite\n            AG5[\&quot;🎙️ 5. Voice-Hotline-Agent (Stufe 2)&lt;br/&gt;• Begrüßung, Ticket-Status &amp;&lt;br/&gt;  automatische Ticket-Anlage\&quot;]:::boxFuture\n        end\n\n        RAG[(\&quot;🗄️ Lokale Vektor-DB (RAG)&lt;br/&gt;• Interne SOPs &amp; PDFs (0 €)\&quot;)]:::boxWhite\n\n        FW --- ROUTER\n        ROUTER --&gt; AGENTS\n        AGENTS &lt;--&gt; RAG\n    end\n\n    %% =========================================================\n    %% 3. MICROSOFT AZURE AI (EU DATA ZONE)\n    %% =========================================================\n    subgraph CLOUD[\&quot;3. MICROSOFT AZURE CLOUD (EU Data Zone | DSGVO-AVV)\&quot;]\n        direction TB\n        AZ_SEC[\&quot;🇪🇺 Region: Sweden Central / DE&lt;br/&gt;• Enterprise Data Protection&lt;br/&gt;• Kein Training mit Firmendaten&lt;br/&gt;• Hartes Budget-Limit im Portal\&quot;]:::boxSec\n\n        LLM_MINI[\&quot;⚡ Smart-Routing (80 %):&lt;br/&gt;GPT-4o-mini / GPT-4.1-mini&lt;br/&gt;• Triage, Chat &amp; Hotline-Dialog&lt;br/&gt;• ~0,16 € / 1M Input-Tokens\&quot;]:::boxWhite\n\n        LLM_PRO[\&quot;🧠 Flaggschiff (20 %):&lt;br/&gt;GPT-4o / GPT-4.1&lt;br/&gt;• Komplexe Analyse &amp; PowerShell&lt;br/&gt;• ~2,55 € / 1M Input-Tokens\&quot;]:::boxWhite\n\n        AZ_SPEECH[\&quot;🗣️ Azure AI Speech (Stufe 2)&lt;br/&gt;• STT (Sprache-&gt;Text): ~0,95 €/Std.&lt;br/&gt;• TTS (Neural Voice): ~14 €/1M Zeichen&lt;br/&gt;• Keine Audio-Speicherung\&quot;]:::boxFuture\n\n        COST_BOX[\&quot;💰 LAUFENDE KOSTEN-ÜBERSICHT&lt;br/&gt;──────────────────────────&lt;br/&gt;• Basis (1.000 Tickets/Monat):&lt;br/&gt;  ca. 5 € – 12 € / Monat&lt;br/&gt;• + Auto-Workflows (3.000 Runs):&lt;br/&gt;  ca. 15 € – 25 € / Monat&lt;br/&gt;• + Hotline TTS/STT (500 Anrufe&lt;br/&gt;  à 3 Min = 25 Std.): ca. 35 € – 45 €&lt;br/&gt;──────────────────────────&lt;br/&gt;GESAMT (Vollausbau): ~50–70 €/Mon.\&quot;]:::boxCost\n\n        AZ_SEC --- LLM_MINI\n        AZ_SEC --- LLM_PRO\n        AZ_SEC --- AZ_SPEECH\n        LLM_PRO --- COST_BOX\n    end\n\n    %% =========================================================\n    %% 4. ANGEBUNDENE AUTOMATISIERUNGEN (SUB-WORKFLOWS)\n    %% =========================================================\n    subgraph AUTO[\&quot;4. ANGEBUNDENE AUTOMATISIERUNGS-WORKFLOWS\&quot;]\n        direction TB\n        WF_USER[\&quot;👤 Onboarding / Offboarding&lt;br/&gt;• AD-User, Gruppen &amp; Lizenzen&lt;br/&gt;• Erst nach Genehmigung (Approval)\&quot;]:::boxWhite\n\n        WF_M365[\&quot;☁️ Entra ID / Intune / Exchange&lt;br/&gt;• Passwort-Reset-Links senden&lt;br/&gt;• Shared Mailbox &amp; Geräte-Sync\&quot;]:::boxWhite\n\n        WF_MON[\&quot;🚨 Monitoring &amp; Self-Healing&lt;br/&gt;• PRTG / Zabbix Alerts prüfen&lt;br/&gt;• Dienste neu starten &amp; Ticket loggen\&quot;]:::boxWhite\n\n        WF_NOTIFY[\&quot;🔔 Eskalation &amp; Teams-Alerts&lt;br/&gt;• P1-Störungen sofort an&lt;br/&gt;  Bereitschafts-Kanal melden\&quot;]:::boxWhite\n    end\n\n    %% =========================================================\n    %% VERBINDUNGEN ZWISCHEN DEN BLÖCKEN\n    %% =========================================================\n    FS &lt;==&gt;|\&quot;HTTPS / TLS 1.3\&quot;| FW\n    TEAMS &lt;==&gt;|\&quot;Webhook / Bot\&quot;| FW\n    VOICE_IN &lt;==&gt;|\&quot;SIP / Audio-Stream\&quot;| AG5\n\n    FW &lt;==&gt;|\&quot;HTTPS / Entra ID\&quot;| AZ_SEC\n    AG5 &lt;==&gt;|\&quot;Echtzeit-Audio\&quot;| AZ_SPEECH\n\n    AG3 --&gt;|\&quot;Trigger (mit Freigabe)\&quot;| WF_USER\n    AG3 --&gt;|\&quot;Graph API / Skript\&quot;| WF_M365\n    AG1 --&gt;|\&quot;Alert-Korrelation\&quot;| WF_MON\n    AG1 --&gt;|\&quot;P1-Eskalation\&quot;| WF_NOTIFY\n\n    class IN zoneIn\n    class CORE zoneCore\n    class CLOUD zoneCloud\n    class AUTO zoneAuto&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Uiee3Jte4tHVJWCuoSTa-2">
